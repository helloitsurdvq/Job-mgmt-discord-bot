# Không đưa token/mật khẩu thật lên Git. Tạo .env từ file này.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=job_bot
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=job_bot
# Với MySQL từ xa, có thể bật TLS và cung cấp chứng chỉ CA.
MYSQL_SSL=false
MYSQL_SSL_CA_FILE=

# Bot kiểm tra hàng đợi và lịch nhắc mỗi 60 giây.
WORKER_INTERVAL_SECONDS=60
